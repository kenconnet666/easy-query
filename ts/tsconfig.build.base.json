{
  // 发布用的构建配置：产出 dist/*.js 与 .d.ts。开发和测试仍直接跑 src 里的 .ts，不依赖 dist
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // 源码里的相对导入写的是 .ts，产出的 JS 里改成 .js
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  }
}